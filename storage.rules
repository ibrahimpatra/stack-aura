rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Website images: public to read (served at https://www.stackaura.cc/media/<name>), only the admin can upload.
    match /media/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
